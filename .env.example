# Shared demo key: only authenticated invites can use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Voice uses gpt-live-1; OPENAI_MODEL also handles delegated coding questions.
WORKSHOP_PORT=4179
# Local development stays on loopback. Set this for Docker or a remote host:
# WORKSHOP_BIND_HOST=0.0.0.0
# Public origins must match browser URLs (including HTTPS and any port):
# WORKSHOP_PUBLIC_ORIGINS=https://game.blackbird.pw
# Hosting platforms may supply PORT, which takes priority over WORKSHOP_PORT.

# Required for invites and personal-key sessions. Use one Redis database/prefix
# across all instances of this demo. Never expose these variables to the browser.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
WORKSHOP_REDIS_PREFIX=little-makers:
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WORKSHOP_SESSION_SECRET=
# Explicit closing time, including timezone; e.g. 2026-09-17T00:00:00+09:00.
# Without a future closing time, shared demo AI is disabled.
WORKSHOP_DEMO_EXPIRES_AT=
WORKSHOP_DEMO_ENABLED=1
WORKSHOP_INVITE_CHATS=50
WORKSHOP_INVITE_VOICE_CALLS=3
# Total for this demo, NOT a daily budget. Changing instances or dates does not reset it.
WORKSHOP_DEMO_TOTAL_CHATS=500
WORKSHOP_DEMO_TOTAL_VOICE_CALLS=30
WORKSHOP_VOICE_SECONDS=120
WORKSHOP_BYOK_DAILY_CHATS=200
WORKSHOP_BYOK_DAILY_VOICE_CALLS=10

# Required for hosted voice. QStash schedules a server-side hangup with retries.
QSTASH_TOKEN=
QSTASH_URL=https://qstash.upstash.io
WORKSHOP_VOICE_CALLBACK_URL=https://game.blackbird.pw/api/voice-expire

# Optional local development only: explicitly allow the server key on loopback.
# Never enables this shortcut on Vercel or on a public-origin request.
# WORKSHOP_LOCAL_AI=1
