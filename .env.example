# Optional: leave blank to use built-in guided examples.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Voice uses gpt-live-1; OPENAI_MODEL also handles delegated coding questions.
WORKSHOP_PORT=4179
# Local development stays on loopback. Set this for Docker or a remote host:
# WORKSHOP_BIND_HOST=0.0.0.0
# Public origins must match browser URLs (including HTTPS and any port):
# WORKSHOP_PUBLIC_ORIGINS=https://game.blackbird.pw
# Hosting platforms may supply PORT, which takes priority over WORKSHOP_PORT.
