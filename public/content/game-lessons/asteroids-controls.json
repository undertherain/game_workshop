{
  "id": "asteroids-controls",
  "title": "Turn both ways",
  "description": "Left already turns your ship. Add the matching Right-key rule in steer_ship().",
  "hint": "Check keyboard.right, then call ship.turn(ship.turn_speed).",
  "starter": [
    "# Turn, thrust, and clear the rocks. Momentum carries you forward.",
    "ship.turn_speed = 4",
