    "    pass",
    "",
    "def apply_thrust():",
    "    if keyboard.thrust:",
    "        ship.thrust()",
    "",
    "def update():",
    "    steer_ship()",
    "    apply_thrust()",
    "    if keyboard.fire:",
    "        ship.fire()",
    "",
    "def on_hit(rock):",
    "    rock.split()",
    "    world.score += 10"
